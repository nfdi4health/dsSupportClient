  DSI,
  dplyr (>= 1.0.2),
  purrr,
  here,
  methods,
  stats
Suggests:
    rmarkdown,
    testthat (>= 3.0.0),
    dsBase,
    DSLite,
    DSOpal
URL: https://github.com/nfdi4health/dsSupportClient
